# Fill TELEGRAM_BOT_TOKEN first, then run npm run telegram:discover.
# Never commit your real .env file or publish your Telegram bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=
DATABASE_URL=postgresql://jobhunter:jobhunter@127.0.0.1:5433/jobhunter
POLL_INTERVAL_MINUTES=15
MAX_TELEGRAM_POSTS_PER_CYCLE=25

# Optional HH-01 setup (read-only; see docs/hh.md)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://127.0.0.1:8765/callback
HH_USER_AGENT=
HH_TOKEN_FILE=.secrets/hh-token.json
# Blank search text/area => broad search; API may require narrowing for large result sets
HH_SEARCH_TEXT=
HH_AREA=
HH_MAX_REQUESTS=80
