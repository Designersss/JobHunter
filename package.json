{
  "name": "jobhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "telegram:discover": "tsx src/telegram-cli.ts discover",
    "telegram:check": "tsx src/telegram-cli.ts check"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.2.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
